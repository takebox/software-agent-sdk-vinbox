# This MANIFEST.in file tells setuptools which files to include 
# in the sdist package distribution used for building docker image

# ==============================================================================
# Root-level workspace files
# ==============================================================================
include pyproject.toml
include uv.lock

# ==============================================================================
# vinbox-sdk
# ==============================================================================
include vinbox-sdk/pyproject.toml
recursive-include vinbox-sdk *.py
recursive-include vinbox-sdk *.j2
recursive-include vinbox-sdk py.typed

# ==============================================================================
# vinbox-tools
# ==============================================================================
include vinbox-tools/pyproject.toml
recursive-include vinbox-tools *.py
recursive-include vinbox-tools *.j2
recursive-include vinbox-tools py.typed

# ==============================================================================
# vinbox-workspace
# ==============================================================================
include vinbox-workspace/pyproject.toml
recursive-include vinbox-workspace *.py
recursive-include vinbox-workspace py.typed

# ==============================================================================
# vinbox-agent-server
# ==============================================================================
include vinbox-agent-server/pyproject.toml
recursive-include vinbox-agent-server *.py
recursive-include vinbox-agent-server py.typed

# Docker build files
include vinbox-agent-server/handprint/agent_server/docker/Dockerfile
include vinbox-agent-server/handprint/agent_server/docker/wallpaper.svg

# PyInstaller spec
include vinbox-agent-server/handprint/agent_server/agent-server.spec

# VSCode extensions
recursive-include vinbox-agent-server/handprint/agent_server/vscode_extensions *
